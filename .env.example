# Database Connection String for Prisma Postgres on Vercel or PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Or for Prisma Accelerate: prisma://accelerate.prisma-data.net/?api_key=...
DATABASE_URL="postgresql://default:password@ep-sample-123456.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# Vercel Blob Storage Token for production image hosting
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_sample"

# NextAuth secret & environment
NEXTAUTH_SECRET="your_nextauth_secret_key_at_least_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GIPHY_API_KEY: Optional custom API key for Giphy Search & Trending
GIPHY_API_KEY="your_giphy_api_key_or_leave_empty_for_public_beta"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
